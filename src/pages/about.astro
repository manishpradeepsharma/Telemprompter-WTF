---
import Layout from '../layouts/Layout.astro';
const title = 'About teleprompter.wtf: Free, Private, Open Source Teleprompter';
const description =
  'Why teleprompter.wtf is free, private, open-source, and intentionally simple. Paste your script and present without an account or cloud database.';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.teleprompter.wtf/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'About',
        item: 'https://www.teleprompter.wtf/about',
      },
    ],
  },
];
---

<Layout title={title} description={description} schema={schema}>
  <article class="prose-page section-wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><span aria-current="page">About</span>
    </nav>
    <header class="page-intro">
      <p class="eyebrow">About the project</p>
      <h1>A teleprompter should not need onboarding.</h1>
      <p>
        teleprompter.wtf is a small, open-source utility built around one idea: paste your words and
        start presenting.
      </p>
    </header>
    <div class="prose-grid">
      <div class="prose-aside"><p>Paste.<br />Present.<br />Done.</p></div>
      <div class="prose-body">
        <h2>Why this exists</h2>
        <p>
          Many teleprompters begin with mandatory account creation, pricing tiers, paywalls, or
          feature-heavy dashboards. Those things get in the way of the moment when you simply need
          readable words moving at the right pace.
        </p>
        <p>
          This project treats speed, typography, privacy, accessibility, and predictable controls as
          the product itself, not as premium extras.
        </p>
        <h2>What it will not do</h2>
        <p>
          teleprompter.sharmacomputers.net will not put scripts in public links, require an account
          for the basic presenter, sell attention to advertisers, watermark your video recordings,
          or claim your words need a cloud database to scroll on your screen.
        </p>
        <h2>Tested across real browsers</h2>
        <p>
          We test and document exact browser capabilities and fallback states. For details on
          desktop and mobile browser support, inspect our <a href="/compatibility"
            >Browser & Device Compatibility Matrix</a
          >.
        </p>
        <h2>Use it, then tell us what hurt</h2>
        <p>
          The most useful contributions are concrete: a browser where fullscreen behaves oddly, a
          control that is hard to reach on a particular phone, or a wording choice that does not
          work with assistive technology. Open a GitHub issue with reproducible details. Never
          include a private script.
        </p>
      </div>
    </div>
  </article>
</Layout>
