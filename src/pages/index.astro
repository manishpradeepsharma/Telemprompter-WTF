---
import TeleprompterApp from '../components/TeleprompterApp';
import MobileQrConnect from '../components/MobileQrConnect';
import Layout from '../layouts/Layout.astro';

const title = 'Free Online Teleprompter That Follows Your Pace | teleprompter.wtf';
const description =
  'A free online teleprompter that follows your pace while your script and voice stay on your device. Zero login, no ads, no watermark. Paste and present.';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'teleprompter.wtf',
    url: 'https://www.teleprompter.wtf/',
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'teleprompter.wtf',
    url: 'https://www.teleprompter.wtf/',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any modern web browser',
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isAccessibleForFree: true,
    image: 'https://www.teleprompter.wtf/illustrations/teleprompter-og.webp',
    featureList: [
      'Manual elapsed-time scrolling',
      'Smart Pace local microphone cadence following',
      'Private Precision Beta on-device speech alignment',
      'Local screen and camera recording',
      'Horizontal mirroring for beam-splitter glass',
      'Document Picture in Picture and compact view',
      'Local autosave and plain-text TXT import',
    ],
    browserRequirements:
      'Requires JavaScript and modern browser APIs (Web Audio, Canvas, MediaRecorder)',
  },
];
---

<Layout
  title={title}
  description={description}
  image="/illustrations/teleprompter-og.webp"
  schema={schema}
>
  <section class="home-hero">
    <div class="home-hero__split">
      <div class="home-hero__copy">
        <p class="eyebrow">Free · Team Scripts · Secure Storage</p>
        <h1>Free online teleprompter that follows your pace</h1>
        <p class="home-hero__lead">
          Paste your script and start. Smart Pace follows your speaking rhythm locally by default,
          while reliable manual scrolling is always available.
        </p>
        <ul class="home-hero__promises">
          <li>Login & Cloud Sync</li>
          <li>No ads</li>
          <li>No watermark</li>
          <li>Server storage & filestore</li>
        </ul>
        <div class="home-hero__mobile-actions">
          <MobileQrConnect client:load />
        </div>
      </div>
      <figure class="home-hero__art">
        <img
          src="/illustrations/teleprompter-hero.webp"
          width="1024"
          height="683"
          alt="Blank script cards flowing through teleprompter glass toward a camera lens"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>
    <TeleprompterApp client:load />
  </section>

  <section class="home-content section-wrap">
    <div class="section-heading">
      <p class="eyebrow">Three ways to present</p>
      <h2>Control that matches your take.</h2>
      <p>
        Manual scrolling is always ready. Smart Pace and Private Precision Beta give you two local
        ways to let the words follow your voice.
      </p>
    </div>
    <div class="feature-list">
      <article>
        <span>01</span><h3>Manual</h3><p>
          Steady, predictable elapsed-time scrolling. Control speed with keyboard shortcuts or
          on-screen buttons. Never requests microphone permission and works offline.
        </p>
      </article>
      <article>
        <span>02</span><h3>Smart Pace (Default)</h3><p>
          Follows your place using the speech recognition built into your browser, and matches your
          speaking rhythm locally when recognition is unavailable. No model download either way.
        </p>
      </article>
      <article>
        <span>03</span><h3>Private Precision (Beta)</h3><p>
          Downloads an optional local speech model (about 67 MB on first use) to recognize spoken
          phrases on-device and align your exact place in the known script. Still Beta.
        </p>
      </article>
    </div>
    <div class="feature-list feature-list--secondary">
      <article>
        <span>04</span><h3>Keep it beside your camera</h3><p>
          Document Picture in Picture on Chromium browsers, with video Picture in Picture and
          pop-out window fallbacks on Firefox and Safari.
        </p>
      </article>
      <article>
        <span>05</span><h3>Prompter-rig ready</h3><p>
          Mirror horizontally for beam-splitter glass, flip vertically for inverted displays, and
          present in fullscreen without browser distractions.
        </p>
      </article>
      <article>
        <span>06</span><h3>Record locally</h3><p>
          Capture your camera or screen directly in the browser. Preview and save your video locally
          without any server upload or watermark.
        </p>
      </article>
    </div>

    <div class="privacy-flow-banner">
      <p class="eyebrow">Local privacy architecture</p>
      <h3>Your script, microphone audio, and video recordings never leave your device.</h3>
      <div class="privacy-flow" aria-label="Local processing flow">
        <span>Local script</span><b aria-hidden="true">→</b><span>Microphone Web Audio</span><b
          aria-hidden="true">→</b
        ><span>In-browser rhythm / alignment</span><b aria-hidden="true">→</b><span
          >Dynamic scroll</span
        >
      </div>
      <p class="home-voice-link">
        Inspect the <a href="/private-voice-tracking">technical voice-tracking boundary</a>, review
        the complete <a href="/features">feature list</a>, check <a href="/compatibility"
          >browser & device compatibility</a
        >, or read our plain-language <a href="/privacy">privacy policy</a>.
      </p>
    </div>

    <div class="home-links">
      <div>
        <p class="eyebrow">Creator & speaker guides</p><h2>Deliver naturally, not mechanically.</h2>
      </div>
      <div class="link-stack">
        <a href="/guides/how-to-use-a-teleprompter"
          ><span>How to use a teleprompter without sounding scripted</span><b aria-hidden="true"
            >↗</b
          ></a
        >
        <a href="/guides/manual-vs-voice-activated-teleprompter"
          ><span>Manual vs. voice-activated teleprompter: which to choose</span><b
            aria-hidden="true">↗</b
          ></a
        >
        <a href="/guides/teleprompter-camera-distance-and-font-size"
          ><span>Camera distance, font size, and line width guide</span><b aria-hidden="true">↗</b
          ></a
        >
        <a href="/guides/teleprompter-speed"
          ><span>Choosing the right teleprompter speed and WPM</span><b aria-hidden="true">↗</b></a
        >
        <a href="/guides/teleprompter-for-youtube"
          ><span>Teleprompter setup for YouTube videos</span><b aria-hidden="true">↗</b></a
        >
        <a href="/tools/words-to-minutes"
          ><span>Turn word count into speaking time</span><b aria-hidden="true">↗</b></a
        >
        <a href="/guides"><span>Browse all teleprompter guides</span><b aria-hidden="true">↗</b></a>
        <a href="/tools"
          ><span>Open all free planning calculators</span><b aria-hidden="true">↗</b></a
        >
      </div>
    </div>
  </section>
</Layout>
